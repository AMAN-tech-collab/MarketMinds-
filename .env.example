# Dual AI Provider Configuration (Server-side only — never expose API keys to browser)
AI_PRIMARY_PROVIDER="gemini"
AI_FALLBACK_PROVIDER="openai"

# Google Gemini API (Primary default)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"

# OpenAI API (Secondary fallback provider when Gemini is rate-limited or unavailable)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# AI Request Timeout in milliseconds
AI_REQUEST_TIMEOUT_MS="30000"

# APP_URL: Public URL where this application is hosted.
APP_URL="http://localhost:3000"

# PORT: HTTP server listening port (default: 3000 in AI Studio, or 5000 for standalone Render backend).
PORT="3000"

# NODE_ENV: development | production
NODE_ENV="development"

# CLIENT_ORIGIN: Allowed CORS frontend origin(s), comma-separated (e.g. https://your-app.vercel.app).
CLIENT_ORIGIN=""

# MARKET_DATA_PROVIDER: Primary market data adapter (default: yahoo-global).
MARKET_DATA_PROVIDER="yahoo-global"

# ALPHAVANTAGE_API_KEY: Optional secondary market data & financial news/sentiment provider key (never exposed to browser).
ALPHAVANTAGE_API_KEY=""

# FINNHUB_API_KEY: Optional market data & company/global financial news provider key (never exposed to browser).
FINNHUB_API_KEY=""

# MARKETAUX_API_KEY: Optional global financial news API key (https://www.marketaux.com, never exposed to browser).
MARKETAUX_API_KEY=""

# GNEWS_API_KEY: Optional global news API key (https://gnews.io, never exposed to browser).
GNEWS_API_KEY=""

# Financial News Caching & Resilience Tuning (milliseconds)
NEWS_CACHE_TTL_MS="180000"
NEWS_STALE_TTL_MS="86400000"
NEWS_REQUEST_TIMEOUT_MS="7000"

# ANALYSIS_SERVICE_URL: Optional external Python FastAPI ML microservice URL (e.g. http://localhost:8001 or https://ai-service.onrender.com).
# When unset, the server runs its built-in quantitative ML & technical analysis engine transparently.
ANALYSIS_SERVICE_URL=""

# JWT_SECRET: Signing secret for email/password JWT tokens (falls back to secure ephemeral key in dev if omitted).
JWT_SECRET=""

# ADMIN_SETUP_PASSCODE: Optional server-side passcode to claim administrator privileges.
ADMIN_SETUP_PASSCODE=""

# PostgreSQL / Cloud SQL connection parameters (configured automatically in AI Studio; set for external Postgres)
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""

# VITE_API_BASE_URL: Frontend API base URL (leave empty for same-origin Express+Vite; set to Render backend URL on Vercel).
VITE_API_BASE_URL=""
